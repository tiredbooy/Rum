{
  "manifest_version": 3,
  "name": "Rum - Send Downloads",
  "short_name": "Rum",
  "version": "0.1.0",
  "description": "Send downloads from your browser to the Rum download manager.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rum",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["contextMenus", "downloads", "cookies", "storage"],
  "host_permissions": ["<all_urls>"]
}
